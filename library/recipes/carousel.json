{
  "id": "carousel",
  "name": "Carousel",
  "family": "social",
  "goals": [
    "teach",
    "grow",
    "sell"
  ],
  "render": "stills",
  "sizes": [
    {
      "w": 1080,
      "h": 1350,
      "ar": "45",
      "id": "4x5",
      "zone": "feed"
    }
  ],
  "count": {
    "story_slides": {
      "default": 7,
      "options": [
        5,
        7,
        9
      ],
      "note": "7–10 slides for teaching; 3–5 for emotional stories"
    },
    "cta_slide": true,
    "max_total": 20
  },
  "parts": [
    {
      "id": "cover",
      "required": true,
      "rule": "Slide 1 = hook; makes them swipe"
    },
    {
      "id": "one_idea_per_slide",
      "required": true,
      "rule": "One idea per slide"
    },
    {
      "id": "cta_slide",
      "required": true,
      "rule": "Last slide: comment keyword, community, save or link"
    }
  ],
  "layout": {
    "items": [
      "slidehead (same size on every slide)",
      "swipe (all but last)",
      "say for dialogue",
      "cta on the last slide"
    ],
    "max_title_chars": 19
  },
  "text": {
    "min_px": {
      "title": 60,
      "body": 44,
      "counter": 80
    }
  },
  "copy": [
    "instagram",
    "alt_text_per_slide",
    "posting_note"
  ],
  "hashtags": {
    "instagram": 5
  },
  "options": [
    "post_copy",
    "hashtags",
    "alt_text"
  ],
  "script_types": [
    "comic-strip",
    "myth-vs-fact",
    "how-to",
    "before-after",
    "calm-tip",
    "ad"
  ],
  "files": [
    "slides",
    "post.md"
  ]
}
