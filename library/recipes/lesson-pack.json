{
  "id": "lesson-pack",
  "name": "Lesson pack",
  "family": "learning",
  "goals": [
    "teach"
  ],
  "render": "video+pdf+stills",
  "sizes": [
    {
      "w": 1920,
      "h": 1080,
      "ar": "169",
      "id": "16x9",
      "zone": "wide"
    },
    {
      "w": 1080,
      "h": 1350,
      "ar": "45",
      "id": "4x5",
      "zone": "feed"
    },
    {
      "w": 1080,
      "h": 1920,
      "ar": "916",
      "id": "9x16",
      "zone": "reel"
    }
  ],
  "length": {
    "min": 120,
    "max": 300,
    "unit": "s"
  },
  "parts": [
    {
      "id": "one_objective",
      "required": true,
      "rule": "One learning objective the learner can act on today"
    },
    {
      "id": "structure",
      "required": true,
      "rule": "hook → why it matters → 3 steps → example with a character → today's action → quiz"
    },
    {
      "id": "quiz",
      "required": true,
      "rule": "3 questions with plausible wrong answers and explanations"
    },
    {
      "id": "teaser",
      "required": true,
      "rule": "A 9:16 teaser reel (15–30 s) that sells the lesson"
    }
  ],
  "text": {
    "min_px": {
      "title": 56,
      "body": 40
    }
  },
  "copy": [
    "lesson_summary",
    "quiz",
    "teaser_post"
  ],
  "hashtags": {
    "instagram": 5
  },
  "options": [
    "subtitles"
  ],
  "files": [
    "lesson video 16x9",
    "slides",
    "worksheet.pdf",
    "summary card 4x5",
    "teaser reel 9x16",
    "post.md"
  ]
}
